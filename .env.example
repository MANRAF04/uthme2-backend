# Compose reads these from the .env next to docker-compose.yml (~/server/.env),
# not from this directory. This file only documents what has to be in there.

DB_PASSWORD=

# Fernet key shared by the API and the Celery worker (must be identical on both).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRED_ENC_KEY=

# University account used by the scheduled menu scrape
BOT_USERNAME=
BOT_PASSWORD=

# Push notifications (grades-notifier only).
# Service account JSON for the Firebase project, mounted read-only at this path.
# Gitignored and never baked into the image, same treatment as uth.ovpn.
FIREBASE_CREDENTIALS_FILE=/app/secrets/firebase-service-account.json
